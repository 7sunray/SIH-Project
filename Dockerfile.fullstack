# Full-stack image: NestJS API + static frontend on the SAME port.
# Repo layout: backend files at root, frontend in web-program/.
FROM node:20-alpine AS builder
WORKDIR /app
RUN apk add --no-cache python3 make g++ openssl
COPY package*.json .npmrc ./
COPY prisma ./prisma
COPY prisma7.config.ts ./
RUN npm ci
COPY src ./src
COPY test ./test
COPY keys ./keys
COPY nest-cli.json tsconfig*.json ./
COPY .npmrc ./
COPY web-program ./public
RUN npm run build
RUN npm prune --omit=dev

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./
COPY --from=builder /app/.npmrc ./
COPY --from=builder /app/keys ./keys
COPY --from=builder /app/public ./public
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma7.config.ts /app/tsconfig.json ./
COPY start-prod.sh ./
RUN sed -i 's/\r$//' start-prod.sh && chmod +x start-prod.sh
RUN npm install --no-save --ignore-scripts --legacy-peer-deps prisma@7.10.0 ts-node@10.9.2 typescript@6.0.3
EXPOSE 3000
CMD ["sh", "start-prod.sh"]
